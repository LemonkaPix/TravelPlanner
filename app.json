{
  "expo": {
    "name": "TravelPlanner",
    "slug": "travelplanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "travelplanner",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1320",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lemonkapix.travelplanner"
    },
    "android": {
      "package": "com.lemonkapix.travelplanner"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing"
    ]
  }
}
