{
  "expo": {
    "name": "TravelPlanner",
    "slug": "travelplanner",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "travelplanner",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0d1320",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lemonkapix.travelplanner"
    },
    "android": {
      "package": "com.lemonkapix.travelplanner",
      "permissions": [
        "com.android.alarm.permission.SET_ALARM"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5626d737-1a8e-4f70-969d-71cfde507693"
      }
    }
  }
}
